{
  "redirects": [
    {
      "source": "/lib/aiGuard.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lib/fb.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lib/adminAuth.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lib/accountDelete.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lib/inciLookup.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lib/inciSim.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lib/scanVerdict.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lib/webCompo.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/lib/webPrice.js",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/data/reference-inci.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/CLAUDE.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tests/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/scripts/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/app-store/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "glow-up-pi.vercel.app"
        }
      ],
      "destination": "https://www.glowupskin.app/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/icons/icon-192.png"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/makeupRender.js": {
      "maxDuration": 60
    },
    "api/coach.js": {
      "maxDuration": 60
    },
    "api/skinInsights.js": {
      "maxDuration": 20
    },
    "api/faceVision.js": {
      "maxDuration": 30
    },
    "api/identifyProduct.js": {
      "maxDuration": 30
    },
    "api/dupeMatch.js": {
      "maxDuration": 60
    },
    "api/inci.js": {
      "maxDuration": 60
    },
    "api/analyzeRoutine.js": {
      "maxDuration": 60
    },
    "api/uploadImage.js": {
      "maxDuration": 30
    },
    "api/saveProducts.js": {
      "maxDuration": 30
    }
  }
}
